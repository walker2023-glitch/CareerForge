# =============================================================================
# Career Forge — environment template
# =============================================================================
# Local:  Copy-Item .env.example .env.local  then paste values below.
# Git:    Never commit .env.local or real secrets.
# Vercel: Add the same variable NAMES in Project → Settings → Environment
#         Variables (Production + Preview). Values only in the dashboard.
#
# Supabase Dashboard → Project Settings → API:
#   - Project URL  → NEXT_PUBLIC_SUPABASE_URL
#   - anon / publishable key → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Anthropic Console → API Keys → ANTHROPIC_API_KEY
# =============================================================================

# --- Required for auth + database (local dev + deployed app) ---

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Claude / AI (server-only; résumé + prep routes when enabled) ---

ANTHROPIC_API_KEY=

# Required explicit provider model ID; no unverified default is selected.
CLAUDE_MODEL=

# MVP: none  |  Live job/prep news search (after smoke test): claude_web
JOB_SEARCH_PROVIDER=none

# --- Deploy / auth redirects (set on Vercel; local dev often http://127.0.0.1:3000) ---

APP_URL=http://127.0.0.1:3000

# --- Server-only trusted résumé insertion (never NEXT_PUBLIC_) ---

SUPABASE_SECRET_KEY=

# --- Fictional E2E accounts (local/CI only; create in Supabase Auth first) ---

# E2E_ISOLATED_DB=1
# E2E_STUDENT_A_EMAIL=
# E2E_STUDENT_A_PASSWORD=
# E2E_STUDENT_B_EMAIL=
# E2E_STUDENT_B_PASSWORD=

# --- Playwright fixture mode (CI default). Omit or set 0 for live Supabase data. ---

# CAREERFORGE_E2E_JOBS_FIXTURE=0
# CAREERFORGE_E2E_PROFILE_FIXTURE=0